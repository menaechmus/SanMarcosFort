class_name Scatter
extends Node3D
## Scenery props (palms, oaks, palmettos, the colonial town) drawn as MultiMeshes from the
## placements generated by tools/blender/build_props.py. Instances are grouped into tiles so
## each tile is culled and level-of-detailed on its own. Lower quality settings thin out the
## vegetation (never the buildings).

const VEGETATION := ["Palm", "Oak", "Palmetto"]
const DENSITY := [0.4, 0.7, 1.0]
const STRIDE := 5

@export var props_scene: PackedScene
@export var data: ScatterData
## Material slot name in the props model -> game material.
@export var materials: Dictionary = {}
@export var tile_size: float = 600.0
@export var visibility_end: float = 3200.0


func _ready() -> void:
	var library := props_scene.instantiate()
	for i in data.names.size():
		var prop_name := data.names[i]
		var source := library.find_child(prop_name, true, false) as MeshInstance3D
		if source == null or source.mesh == null:
			push_warning("Scatter: no mesh named %s in the props model" % prop_name)
			continue
		var density: float = DENSITY[Settings.quality] if VEGETATION.has(prop_name) else 1.0
		_place(prop_name, _with_materials(source.mesh), data.data[i], density)
	library.free()


func _with_materials(mesh: Mesh) -> Mesh:
	var copy := mesh.duplicate() as ArrayMesh
	for s in copy.get_surface_count():
		var source := copy.surface_get_material(s)
		if source != null and materials.has(source.resource_name):
			copy.surface_set_material(s, materials[source.resource_name])
	return copy


func _place(prop_name: String, mesh: Mesh, values: PackedFloat32Array, density: float) -> void:
	var rng := RandomNumberGenerator.new()
	rng.seed = hash(prop_name)
	var tiles := {}
	for i in values.size() / STRIDE:
		if density < 1.0 and rng.randf() > density:
			continue
		var key := Vector2i(floori(values[i * STRIDE] / tile_size), floori(values[i * STRIDE + 2] / tile_size))
		if not tiles.has(key):
			tiles[key] = PackedInt32Array()
		tiles[key].append(i)
	for key: Vector2i in tiles:
		var ids: PackedInt32Array = tiles[key]
		var multimesh := MultiMesh.new()
		multimesh.transform_format = MultiMesh.TRANSFORM_3D
		multimesh.mesh = mesh
		multimesh.instance_count = ids.size()
		for j in ids.size():
			var b := ids[j] * STRIDE
			var basis := Basis(Vector3.UP, values[b + 3]).scaled(Vector3.ONE * values[b + 4])
			multimesh.set_instance_transform(j, Transform3D(basis, Vector3(values[b], values[b + 1], values[b + 2])))
		var instance := MultiMeshInstance3D.new()
		instance.name = "%s_%d_%d" % [prop_name, key.x, key.y]
		instance.multimesh = multimesh
		instance.visibility_range_end = visibility_end
		add_child(instance)
